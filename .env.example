# ╔══════════════════════════════════════════════════════════════════╗
# ║   Product Video Discovery Dashboard — Environment Variables     ║
# ║   Copy this file to .env and fill in your values               ║
# ╚══════════════════════════════════════════════════════════════════╝

# ─────────────────────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────
# DATABASE  (SQLite — no extra setup needed)
# The file will be created automatically in backend/prisma/
# ─────────────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ─────────────────────────────────────────────────────────────────────
# REDIS  (use Docker Compose: docker compose up redis)
# ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# Use "bullmq" with Redis for production/Docker. Use "inline" for local dev without Redis.
QUEUE_MODE=bullmq

# ─────────────────────────────────────────────────────────────────────
# GOOGLE GEMINI API KEY  (FREE TIER — Vision + Embeddings)
#
# How to get it (free, no credit card needed):
#   1. Go to: https://aistudio.google.com/app/apikey
#   2. Sign in with a Google account
#   3. Click "Create API key" → select or create a project
#   4. Copy the key and paste it below
#
# Defaults use Gemini Flash for vision because it is available through this SDK.
# Keep VLM_TOP_N modest on the free tier to avoid rate-limit stalls.
# ─────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# Gemma 3 model IDs are not exposed by all Google AI Studio keys on v1beta.
VISION_MODEL=gemini-3.5-flash-lite
VISION_MODEL_FALLBACKS=gemini-3.5-flash,gemini-2.5-flash,gemma-4-26b-a4b-it
EMBEDDING_MODEL=gemini-embedding-2
VLM_TOP_N=15
KEYWORD_INSTAGRAM_QUERIES=6

# Organic-first source configuration.
# Default searches return Instagram Reels with no detected paid markers.
# Add "meta" only when you explicitly want Meta Ad Library ads in comparison mode.
SEARCH_SOURCES=instagram
INSTAGRAM_PROVIDER=apify
TARGET_RESULTS=20
MAX_REFILL_ROUNDS=6
MIN_REFILL_YIELD=1
MAX_APIFY_RUNS_PER_JOB=8
DAILY_PROVIDER_RUN_BUDGET=200
PROVIDER_CACHE_TTL_MS=21600000
COLLECTOR_CONCURRENCY=1
PER_CREATOR_CAP=3

# ─────────────────────────────────────────────────────────────────────
# APIFY API TOKEN  (Instagram Reels scraper)
#
# How to get it:
#   1. Go to: https://apify.com  →  Sign up (free plan available)
#   2. Free plan gives $5/month credit — enough for testing
#   3. Go to: https://console.apify.com/account/integrations
#   4. Copy your "Personal API token" and paste below
#
# Actor used: instagram-reel-scraper
# ─────────────────────────────────────────────────────────────────────
APIFY_API_TOKEN=your_apify_api_token_here

# ─────────────────────────────────────────────────────────────────────
# OPTIONAL / ADS MODE: META AD LIBRARY ACCESS TOKEN
#
# How to get it:
#   1. Go to: https://developers.facebook.com/
#   2. Create an app → select "Business" type
#   3. Add product: "Marketing API"
#   4. Go to Graph API Explorer → generate a user token
#   5. Required permission: ads_read
#
# NOTE: Meta Ad Library is ads-only. It is disabled unless SEARCH_SOURCES includes "meta".
# ─────────────────────────────────────────────────────────────────────
META_AD_LIBRARY_ACCESS_TOKEN=your_meta_token_here
META_ENABLE_OFFICIAL=false
META_FALLBACK_COUNTRY=US
META_FALLBACK_MAX_POLLS=6

# ─────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────

# Set to "true" to use saved fixture files instead of live API calls.
# Graders: use this if live APIs are unavailable in your environment.
USE_FIXTURES=false

# Set to "true" to enable the TikTok bonus collector.
ENABLE_TIKTOK=false

# ─────────────────────────────────────────────────────────────────────
# TIMEOUTS & LIMITS
# ─────────────────────────────────────────────────────────────────────
REQUEST_TIMEOUT_MS=10000
